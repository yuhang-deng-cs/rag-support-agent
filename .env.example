# Copy to .env and adjust. Every setting is documented in app/core/config.py.

# development | test | production  (production refuses insecure defaults)
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# SQLite works out of the box. For Row-Level Security use PostgreSQL and connect as an
# unprivileged role (see infra/postgres/app_role.psql):
# DATABASE_URL=postgresql://rag_app:password@localhost:5432/rag
DATABASE_URL=sqlite+aiosqlite:///./rag_local.db

# Load two demo workspaces (acme, umbra). Password for all demo users: demo-password
SEED_DEMO=true

# Embeddings: fastembed (local, default) | openai (any OpenAI-compatible API) | hash (tests)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RETRIEVAL_MIN_SCORE=0.6

# Answers: extractive (offline, no key) | openai (any OpenAI-compatible chat API)
LLM_PROVIDER=extractive
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1   (no key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# inline (in-process, no Redis) | celery (needs REDIS_URL and a worker)
INGESTION_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# Rate limits (requests per minute). memory = single process | redis = shared across replicas (REDIS_URL)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
LOGIN_RATE_PER_MINUTE=10
CHAT_RATE_PER_MINUTE=30
